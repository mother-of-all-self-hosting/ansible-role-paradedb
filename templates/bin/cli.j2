# Runs psql inside the (running) ParadeDB container, connecting the same way the managed databases preparation does.
# The credentials come from the env-paradedb-psql file, which Docker reads itself, so that they do not appear on any command line.
# A TTY is only requested when there is one, so that SQL can also be piped in (e.g. `echo 'SELECT 1' | cli`).
docker_exec_args=(-i)
if [ -t 0 ]; then
    docker_exec_args+=(-t)
fi

exec docker exec \
    "${docker_exec_args[@]}" \
    --env-file={{ paradedb_base_path }}/env-paradedb-psql \
    {{ paradedb_identifier }} \
    psql -h {{ paradedb_run_path_in_container if paradedb_cli_use_unix_socket_enabled else '127.0.0.1' }} \
    "$@"
