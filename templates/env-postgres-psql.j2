PGUSER={{ paradedb_connection_username }}
PGPASSWORD={{ paradedb_connection_password }}
PGDATABASE={{ paradedb_db_name }}
# Prevent errors like this:
# > could not save history to file "//.psql_history": Permission denied
# .. due to ParadeDB not being able to write to the filesystem.
PSQL_HISTORY=/dev/null
