[Unit]
Description=ParadeDB server ({{ paradedb_identifier }})
{% for service in paradedb_systemd_required_services_list %}
Requires={{ service }}
After={{ service }}
{% endfor %}
DefaultDependencies=no

[Service]
Type=simple
Environment="HOME={{ devture_systemd_docker_base_systemd_unit_home_path }}"
ExecStartPre={{ devture_systemd_docker_base_host_command_sh }} -c '{{ paradedb_container_cleanup_command | trim | replace("\n", " ") }}'

# We need /dev/shm to be larger than the default to allow VACUUM to work.
# See:
# - https://github.com/spantaleev/matrix-docker-ansible-deploy/issues/1362
# - https://github.com/spantaleev/matrix-docker-ansible-deploy/issues/1268
ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} create \
      --rm \
      --name {{ paradedb_identifier }} \
      --log-driver=none \
      --user={{ paradedb_container_uid }}:{{ paradedb_container_gid }} \
      {% if paradedb_container_cap_drop_all_enabled %}
      --cap-drop=ALL \
      {% endif %}
      {% if paradedb_container_read_only_enabled %}
      --read-only \
      {% endif %}
      --shm-size={{ paradedb_container_shm_size }} \
      --network={{ paradedb_container_network }} \
      {% if paradedb_container_paradedb_bind_port %}
      -p {{ paradedb_container_paradedb_bind_port }}:5432 \
      {% endif %}
      --env-file={{ paradedb_base_path }}/env-paradedb-server \
      --mount type=bind,src={{ paradedb_data_path }},dst={{ paradedb_data_in_container_path }} \
      {% if paradedb_container_unix_socket_enabled %}
      --mount type=bind,src={{ paradedb_run_path }},dst={{ paradedb_run_path_in_container }} \
      {% endif %}
      {% if paradedb_container_mount_etc_passwd_enabled %}
      --mount type=bind,src=/etc/passwd,dst=/etc/passwd,ro \
      {% endif %}
      --tmpfs=/tmp:rw,noexec,nosuid,size={{ paradedb_container_tmpfs_tmp_size }} \
      {% if not paradedb_container_unix_socket_enabled %}
      --tmpfs={{ paradedb_run_path_in_container }}:rw,noexec,nosuid,size={{ paradedb_container_tmpfs_run_size }} \
      {% endif %}
      {% for arg in paradedb_container_extra_arguments %}
      {{ arg }} \
      {% endfor %}
      {{ paradedb_container_image_to_use }} \
      postgres {{ paradedb_process_extra_arguments | join(' ') }}

{% if paradedb_container_network != 'host' %}
{% for network in paradedb_container_additional_networks %}
ExecStartPre={{ devture_systemd_docker_base_host_command_docker }} network connect {{ network }} {{ paradedb_identifier }}
{% endfor %}
{% endif %}

ExecStart={{ devture_systemd_docker_base_host_command_docker }} start --attach {{ paradedb_identifier }}

{% if paradedb_systemd_readiness_check_enabled %}
# Only count the service as started once ParadeDB accepts connections. Otherwise, services ordered
# after this one (`After=`) get started while ParadeDB is still initializing, and those that set up
# their database only once at startup end up running against an empty one.
#
# Why TCP and not the Unix socket: when the data directory is empty, the image's entrypoint first
# initializes it through a temporary server, which does listen on the Unix socket but runs with
# `listen_addresses=''`. That server is then shut down and replaced by the real one. A check over the
# socket would already succeed against the temporary server; one over TCP only succeeds once the
# real server is up.
#
# `pg_isready` does not authenticate, so no credentials are needed. `-U` is passed anyway, because
# without it `pg_isready` gives up when the container's user has no `/etc/passwd` entry.
# `-d` names a database that exists: without it, `pg_isready` asks for one named after the user,
# which ParadeDB refuses with a harmless but noisy `FATAL: database "..." does not exist` log line.
#
# The `-` prefix makes a timeout non-fatal: the service then counts as started, as it did before this
# check existed. A setup where ParadeDB does not listen on TCP is thus delayed, but not broken.
ExecStartPost=-{{ devture_systemd_docker_base_host_command_sh }} -c 'timeout {{ paradedb_systemd_readiness_check_timeout_seconds }} {{ devture_systemd_docker_base_host_command_sh }} -c "until {{ devture_systemd_docker_base_host_command_docker }} exec {{ paradedb_identifier }} pg_isready --quiet --host=127.0.0.1 --port=5432 --username={{ paradedb_connection_username }} --dbname={{ paradedb_db_name }}; do sleep 1; done"'
TimeoutStartSec={{ paradedb_systemd_readiness_check_timeout_seconds | int + 120 }}
{% endif %}

ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} stop -t {{ paradedb_container_stop_grace_time_seconds }} {{ paradedb_identifier }} 2>/dev/null || true'
ExecStop=-{{ devture_systemd_docker_base_host_command_sh }} -c '{{ devture_systemd_docker_base_host_command_docker }} rm {{ paradedb_identifier }} 2>/dev/null || true'

Restart=always
RestartSec=30
SyslogIdentifier={{ paradedb_identifier }}

[Install]
WantedBy=multi-user.target
